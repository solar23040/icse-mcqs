---
import '../styles/global.css';
import HeaderGame from '../components/game/HeaderGame.svelte';
import ThemeToggle from '../components/shell/ThemeToggle.svelte';
import NameModal from '../components/game/NameModal.svelte';
import Presence from '../components/game/Presence.svelte';
import SyncManager from '../components/settings/SyncManager.svelte';

interface Props {
  title?: string;
  description?: string;
  /** Keep utility pages out of search results. */
  noindex?: boolean;
}

const {
  title,
  description = 'Practise ICSE Class 10 multiple-choice questions for History & Civics, Economics, Geography, Maths and English Literature.',
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ICSE 10 MCQs` : 'ICSE Class 10 MCQ Practice';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {
          /* localStorage can be blocked; fall back to the system preference */
        }
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = stored === 'dark' || (stored !== 'light' && prefersDark);
        document.documentElement.classList.toggle('dark', isDark);
        document.documentElement.style.colorScheme = isDark ? 'dark' : 'light';
      })();
    </script>
    <title>{pageTitle}</title>
  </head>
  <body class="flex min-h-dvh flex-col bg-slate-50 text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-indigo-600 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
    >
      Skip to content
    </a>

    <header class="sticky top-0 z-40 border-b border-slate-200 bg-slate-50/90 backdrop-blur dark:border-slate-800 dark:bg-slate-950/90">
      <div class="mx-auto flex w-full max-w-5xl items-center justify-between gap-4 px-4 py-3">
        <a href="/" class="flex items-center gap-2 rounded-lg text-sm font-semibold tracking-tight text-slate-900 dark:text-slate-100">
          <span class="grid h-8 w-8 place-items-center rounded-lg bg-indigo-600 text-sm font-bold text-white dark:bg-indigo-500">
            10
          </span>
          <span>ICSE MCQs</span>
        </a>
        <div class="flex items-center gap-2">
          <a
            href="/profile"
            class="flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-200/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:text-slate-200 dark:hover:bg-slate-800"
            title="My Profile & Stats"
          >
            <span aria-hidden="true">👤</span>
            <span class="hidden sm:inline">Profile</span>
          </a>
          <HeaderGame client:load />
          <a
            href="/settings"
            class="inline-flex h-10 items-center gap-2 rounded-full border border-slate-300 px-3 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-200/70 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
            aria-label="Settings"
            title="Settings"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="12" cy="12" r="3" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6 1.7 1.7 0 0 0-.4 1.1V21a2 2 0 1 1-4 0v-.09A1.7 1.7 0 0 0 8.6 19.4a1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.6-1 1.7 1.7 0 0 0-1.1-.4H3a2 2 0 1 1 0-4h.09A1.7 1.7 0 0 0 4.6 8.6a1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.6 1.7 1.7 0 0 0 .4-1.1V3a2 2 0 1 1 4 0v.09A1.7 1.7 0 0 0 15.4 4.6a1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.4 9c.14.36.36.68.65.94.3.26.67.4 1.05.4H21a2 2 0 1 1 0 4h-.09a1.7 1.7 0 0 0-1.51.66Z" />
            </svg>
            <span class="hidden sm:inline">Settings</span>
          </a>
          <ThemeToggle client:load />
        </div>
      </div>
    </header>

    <NameModal client:load />
    <Presence client:load />
    <SyncManager client:load />

    <main id="main" tabindex="-1" class="mx-auto w-full max-w-5xl scroll-mt-20 flex-1 px-4 pb-16 pt-6 sm:pt-10">
      <slot />
    </main>

    <footer class="border-t border-slate-200 py-6 dark:border-slate-800">
      <div class="mx-auto flex w-full max-w-5xl flex-wrap items-center justify-between gap-2 px-4 text-sm text-slate-500 dark:text-slate-400">
        <p>ICSE Class 10 practice. Progress is saved in this browser. Optional cross-device sync is off by default.</p>
        <div class="flex flex-wrap items-center gap-4">
          <a href="/settings" class="font-semibold text-indigo-600 underline-offset-4 hover:underline dark:text-indigo-400">
            Accounts &amp; sync
          </a>
          <a href="/poll" class="font-semibold text-indigo-600 underline-offset-4 hover:underline dark:text-indigo-400">
            Vote on the next subject →
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
