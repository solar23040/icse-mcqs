---
import Base from '../layouts/Base.astro';
import SubjectTabs from '../components/shell/SubjectTabs.astro';
import SubjectMastery from '../components/game/SubjectMastery.svelte';
import Quiz from '../components/quiz/Quiz.svelte';
import { SUBJECTS } from '../lib/subjects';
import { toClientQuestions } from '../lib/questions';
import type { Question, Subject } from '../lib/types';

export function getStaticPaths() {
  return SUBJECTS.map(({ slug, title, placeholder }) => ({
    params: { subject: slug },
    props: { title, placeholder: placeholder ?? false },
  }));
}

interface Props {
  title: string;
  placeholder: boolean;
}

const { title, placeholder } = Astro.props;
const subject = Astro.params.subject as Subject;

const modules = import.meta.glob<Question>('../data/*.json', { eager: true, import: 'default' });
const questions = toClientQuestions(modules[`../data/${subject}.json`] ?? []);
const comingSoon = placeholder || questions.length === 0;
---

<Base
  title={`${title} practice`}
  description={`Practise ICSE Class 10 ${title} multiple-choice questions with explanations for every answer.`}
>
  <SubjectTabs active={subject} />

  <section class="mb-6 max-w-2xl">
    <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400">ICSE Class 10</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
    <p class="mt-3 text-base leading-relaxed text-slate-600 dark:text-slate-400">
      {comingSoon
        ? 'Questions for this subject are being written and checked right now. Check back soon.'
        : 'Choose a session length, then work through each question at your own pace.'}
    </p>
    {!comingSoon && <SubjectMastery client:load questions={questions} />}
  </section>

  {
    comingSoon ? (
      <div class="max-w-2xl rounded-2xl border border-dashed border-slate-300 bg-white p-6 dark:border-slate-700 dark:bg-slate-900">
        <h2 class="text-lg font-semibold tracking-tight">Coming soon</h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
          {title} is on the way. In the meantime, try one of the subjects that already has questions.
        </p>
        <a
          href="/"
          class="mt-4 inline-flex items-center gap-1 rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-400 dark:text-slate-950"
        >
          Browse subjects <span aria-hidden="true">→</span>
        </a>
      </div>
    ) : (
      <Quiz client:load subject={subject} questions={questions} />
    )
  }
</Base>
