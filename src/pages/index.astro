---
import Base from '../layouts/Base.astro';
import HomeGamePanel from '../components/game/HomeGamePanel.svelte';
import LeaderboardPanel from '../components/game/LeaderboardPanel.svelte';
import SubjectGrid from '../components/shell/SubjectGrid.svelte';
import { SUBJECTS } from '../lib/subjects';
import type { Question } from '../lib/types';

const modules = import.meta.glob<Question>('../data/*.json', { eager: true, import: 'default' });
const questionIds = Object.fromEntries(
  SUBJECTS.map(({ slug }) => [
    slug,
    (modules[`../data/${slug}.json`] ?? []).map((question) => question.id),
  ]),
);
const allQuestionIds = Object.values(questionIds).flat();
---

<Base>
  <section class="mb-8 max-w-2xl">
    <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400">ICSE Class 10</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Practice MCQs by subject</h1>
    <p class="mt-3 text-base leading-relaxed text-slate-600 dark:text-slate-400">
      Pick a subject, choose a session length, and get an explanation after every answer. Your progress and accuracy are
      saved in this browser, with optional cross-device sync in
      <a href="/settings" class="font-semibold text-indigo-600 underline-offset-4 hover:underline dark:text-indigo-400">settings</a>.
    </p>
  </section>

  <HomeGamePanel client:load questionIds={allQuestionIds} />

  <a
    href="/mock"
    class="mb-8 flex flex-wrap items-center justify-between gap-4 rounded-3xl border border-indigo-200 bg-indigo-50 p-5 transition-colors hover:border-indigo-400 hover:bg-indigo-100 dark:border-indigo-500/40 dark:bg-indigo-950/30 dark:hover:border-indigo-400 dark:hover:bg-indigo-950/50 sm:p-6"
  >
    <div class="max-w-xl">
      <p class="text-sm font-semibold uppercase tracking-wide text-indigo-700 dark:text-indigo-300">Mock exam</p>
      <p class="mt-1 text-lg font-bold tracking-tight">Sit a timed, mixed-subject paper</p>
      <p class="mt-1 text-sm text-indigo-900/80 dark:text-indigo-200/80">
        One timer, no hints, then a full score breakdown by subject and topic.
      </p>
    </div>
    <span
      class="inline-flex min-h-11 items-center rounded-xl bg-indigo-600 px-5 text-sm font-semibold text-white shadow-sm"
    >
      Start a paper →
    </span>
  </a>

  <LeaderboardPanel client:load />

  <SubjectGrid client:load subjects={SUBJECTS} questionIds={questionIds} />

  <p class="mt-6 text-sm text-slate-600 dark:text-slate-400">
    Missing a subject?
    <a href="/poll" class="font-semibold text-indigo-600 underline-offset-4 hover:underline dark:text-indigo-400">
      Vote on which one we add next →
    </a>
  </p>
</Base>
