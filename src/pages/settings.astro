---
import Base from '../layouts/Base.astro';
import SettingsPanel from '../components/settings/SettingsPanel.svelte';
---

<Base
  title="Settings"
  description="Manage local accounts and optional cross-device progress sync for ICSE Class 10 MCQ practice."
>
  <section class="mb-8 max-w-2xl">
    <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400">Settings</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Accounts &amp; sync</h1>
    <p class="mt-3 text-base leading-relaxed text-slate-600 dark:text-slate-400">
      Add more than one person to this browser, or optionally link an account with a password so you can continue on
      another device. Cross-device sync is off by default.
    </p>
  </section>

  <SettingsPanel client:load />
</Base>
