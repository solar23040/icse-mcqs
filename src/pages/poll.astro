---
import Base from '../layouts/Base.astro';
import SubjectPoll from '../components/poll/SubjectPoll.svelte';
---

<Base
  title="Vote on the next subject"
  description="Vote for the ICSE Class 10 subject you want added next: Mass Media, Physical Education, Computer Applications, Hindi, Physics, Chemistry, Biology, Commercial Studies or English Language."
>
  <section class="mb-8 max-w-2xl">
    <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400">Help shape the site</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Which subject should we add next?</h1>
    <p class="mt-3 text-base leading-relaxed text-slate-600 dark:text-slate-400">
      Pick the subject you would find most useful for ICSE Class 10 practice. The poll is stored in your browser, so you
      can change your answer at any time.
    </p>
  </section>

  <SubjectPoll client:load />

  <noscript>
    <p class="mt-4 max-w-2xl rounded-xl bg-amber-50 p-4 text-sm text-amber-800 dark:bg-amber-500/10 dark:text-amber-300">
      The poll needs JavaScript to record your vote. You can still practise every subject without it.
    </p>
  </noscript>

  <p class="mt-8">
    <a
      href="/"
      class="text-sm font-semibold text-indigo-600 underline-offset-4 hover:underline dark:text-indigo-400"
    >
      ← Back to practice
    </a>
  </p>
</Base>
