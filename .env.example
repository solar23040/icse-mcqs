# Upstash Redis (poll + weekly leaderboard)
# Copy to .env.local for `vercel dev`. Vercel injects these automatically in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# /dev panel login. PUBLIC_ values are compiled into the client bundle, so
# treat them as a casual-access gate, not a secret. Leave blank to disable.
PUBLIC_DEV_USERNAME=
PUBLIC_DEV_PASSWORD=
